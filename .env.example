# Copie para ".env" e preencha. O .env NÃO vai para o git.
# Só é necessário para o modo Spotify (Audius e Demo funcionam sem isto).
#
# Client ID do app criado em https://developer.spotify.com/dashboard
# (não é segredo no fluxo PKCE — mas NUNCA coloque o Client Secret aqui).
VITE_SPOTIFY_CLIENT_ID=

# Precisa ser IGUAL ao cadastrado em "Redirect URIs" no dashboard.
# Spotify não aceita "localhost": use 127.0.0.1 (ou https em produção).
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
